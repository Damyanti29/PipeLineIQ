# PipelineIQ configuration. Copy to backend/.env and fill in what you have; every integration
# is optional and turns on as soon as its values are set. The frontend reads the public
# Supabase values from this file too, so frontend/.env is optional.
#
# Check everything with:  npm run check-env

NODE_ENV=development
PORT=5000
# Comma-separate multiple origins if needed. Must be https in production.
FRONTEND_URL=http://localhost:5173

# Public https URL of this API, e.g. your ngrok domain (https://name.ngrok-free.app).
# Needed for Slack and GitHub webhooks. OAuth redirect URIs are derived from it.
# Leave empty for http://localhost:5000.
PUBLIC_API_URL=

# ─── Supabase → Project Settings → API ──────────────────────────
SUPABASE_URL=
# anon / publishable key (public)
SUPABASE_ANON_KEY=
# service_role / secret key. Server-side only, never in the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# ─── GitHub App → General ───────────────────────────────────────
# Numeric App ID (not the Client ID)
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Private key: easiest is to drop the downloaded .pem file into backend/ and leave both empty.
# Or point at it:      GITHUB_APP_PRIVATE_KEY_PATH=github-app.pem
# Or paste it inline:  GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY=
# Optional override. Default: <PUBLIC_API_URL>/api/github/callback
GITHUB_REDIRECT_URI=

# ─── Slack app → Basic Information → App Credentials ────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Optional override. Default: <PUBLIC_API_URL>/api/slack/callback (Slack requires https)
SLACK_REDIRECT_URI=

# ─── Gemini → https://aistudio.google.com/app/apikey ────────────
GEMINI_API_KEY=
# Falls back to gemini-flash-latest automatically if this model is retired or overloaded.
GEMINI_MODEL=gemini-3.5-flash

# ─── Push monitoring ────────────────────────────────────────────
# Gemini reviews every push's diff (CI failures are always analysed). true/false
PUSH_REVIEW=true
# Open a ready-to-merge PR with the suggested fix. false = Slack alert only. true/false
AUTO_FIX_PR=true

# Optional. Without Redis, jobs run inside the API process.
REDIS_URL=redis://localhost:6379

# Encrypts stored Slack tokens and signs OAuth state (min 32 chars). Leave empty in development:
# one is generated and saved here on first start. Never change it once Slack is connected.
APP_ENCRYPTION_KEY=
