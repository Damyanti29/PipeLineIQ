NODE_ENV=development
PORT=5000
# Comma-separate multiple origins if needed. Must be https in production.
FRONTEND_URL=http://localhost:5173

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Never expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

GITHUB_APP_ID=
# PEM contents; either real newlines inside quotes or "\n" escapes on one line.
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5000/api/github/callback

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

REDIS_URL=redis://localhost:6379

# Random secret (min 32 chars) used to encrypt stored Slack tokens and sign OAuth state.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=""
