# Optional. Empty values are taken from backend/.env automatically (SUPABASE_URL,
# SUPABASE_ANON_KEY, PORT). Set them here only to point the frontend somewhere else.
#
# Public values only: everything prefixed with VITE_ is bundled into the browser.
# Never put the Supabase service role key or any other secret here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=
